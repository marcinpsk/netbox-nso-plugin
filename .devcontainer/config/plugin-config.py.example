"""
Plugin configuration for the NetBox NSO Plugin in the dev container.

- Copy this file to .devcontainer/config/plugin-config.py
- Set ADAPTER_URL and ADAPTER_BEARER_TOKEN in .devcontainer/.env
"""
import os

PLUGINS = [
    "netbox_nso_plugin",
]

PLUGINS_CONFIG = {
    "netbox_nso_plugin": {
        "adapter_url": os.environ.get("ADAPTER_URL", ""),
        "adapter_token": os.environ.get("ADAPTER_BEARER_TOKEN", ""),
    },
}
