#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Copyright (C) 2026 Marcin Zieba
# Run custom checks locally without replacing CodeRabbit's default rules.
set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
scan_bin="${OPENGREP_BIN:-opengrep}"
mode="${1:-scan}"
if (( $# )); then shift; fi
case "$mode" in
  scan)
    if (( $# == 0 )); then
      shopt -s globstar nullglob
      set -- netbox_nso_plugin netbox_nso_plugin/tests/**/*.py .github/ci/**/*.py conftest.py isolated_test_settings.py contract_tests/**/*.py netbox_stubs/**/*.py .devcontainer/**/*.py
    fi
    "$scan_bin" scan --no-git-ignore --include '*.py' --max-target-bytes 0 --config .opengrep/nso-rules.yaml --error -- "$@"
    python3 .opengrep/check-adapter-error-continue.py scan
    python3 .opengrep/check-resume-failure-guidance.py scan
    ;;
  test)
    if (( $# )); then echo "test does not accept arguments" >&2; exit 2; fi
    staging_dir="$(mktemp -d)"
    trap 'rm -rf "$staging_dir"' EXIT
    cp .opengrep/nso-rules.yaml "$staging_dir/review-patterns.yaml"
    cp .opengrep/tests/review-patterns.py "$staging_dir/review-patterns.py"
    "$scan_bin" test "$staging_dir"
    python3 .opengrep/tests/coverage.py --opengrep-bin "$scan_bin"
    python3 .opengrep/check-adapter-error-continue.py test .opengrep/tests/review-patterns.py
    python3 .opengrep/check-resume-failure-guidance.py test .opengrep/tests/review-patterns.py
    ;;
  *) echo "Usage: $0 [scan [path ...] | test]" >&2; exit 2 ;;
esac
